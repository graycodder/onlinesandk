rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.admin == true ||
        (exists(/databases/$(database)/documents/admins/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.active == true)
      );
    }

    // Products Collection
    match /products/{productId} {
      // Public can only read published garments
      allow read: if resource.data.status == 'published' || isAdmin();
      // Only authenticated admins can write
      allow create, update, delete: if isAdmin();
    }

    // Collections
    match /collections/{collectionId} {
      // Public can only read published collections
      allow read: if resource.data.status == 'published' || isAdmin();
      // Only authenticated admins can write
      allow create, update, delete: if isAdmin();
    }

    // Store Settings
    match /settings/{settingId} {
      // Public can read general store settings
      allow read: if true;
      // Only authenticated admins can update store settings
      allow write: if isAdmin();
    }

    // Administrator registry
    match /admins/{adminUid} {
      // Admins can read their own document
      allow read: if isAuthenticated() && request.auth.uid == adminUid;
      // Owner email can self-register on first login (bootstrap only)
      allow create: if isAuthenticated()
        && request.auth.uid == adminUid
        && request.auth.token.email == 'onlinesandk@gmail.com'
        && request.resource.data.active == true;
      // Existing admins can update their own record
      allow update, delete: if isAdmin();
    }
  }
}
